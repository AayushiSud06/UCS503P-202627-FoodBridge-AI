        <mxCell id="c123" value="+reasons : str [*]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontColor=#3A322A;" parent="c113" vertex="1">
          <mxGeometry x="0" y="204" width="147" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c124" value="" style="line;strokeWidth=1;strokeColor=#B07D34;fillColor=none;align=center;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=center;points=[];portConstraint=eastwest;html=1;fontSize=9;fontColor=#6E6257;" parent="c113" vertex="1">
          <mxGeometry x="0" y="222" width="147" height="8" as="geometry" />
        </mxCell>
        <mxCell id="c125" value="No domain inheritance. A role is an&lt;br&gt;enumerated attribute on one `users` table,&lt;br&gt;not a class hierarchy. `Recipient` and&lt;br&gt;`Volunteer` are *profile* records associated&lt;br&gt;with an account, not subclasses of it." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#F5F7F5;strokeColor=#9FB3A5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;size=14;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="124" y="36" width="247" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c126" value="`Requirement` has no association with&lt;br&gt;`Donation` and is not read by `Matching`.&lt;br&gt;The needs board makes demand visible to&lt;br&gt;donors; it does not drive the matcher." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#F5F7F5;strokeColor=#9FB3A5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;size=14;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="700" y="1064" width="243" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c127" value="Transient — computed per request and never&lt;br&gt;persisted. Only the integer `overall_score`&lt;br&gt;survives, frozen into `Donation.match_score`&lt;br&gt;when the donation is posted and again when&lt;br&gt;it is first accepted." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#F5F7F5;strokeColor=#9FB3A5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;size=14;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="979" y="1056" width="261" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c128" value="`Recipient./reliability_score` feeds the&lt;br&gt;ranking, and `accepted_donations` /&lt;br&gt;`completed_donations` are maintained by the&lt;br&gt;donation lifecycle — so completing a&lt;br&gt;donation changes future match scores." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#F5F7F5;strokeColor=#9FB3A5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;size=14;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="997" y="626" width="260" height="88" as="geometry" />
        </mxCell>
